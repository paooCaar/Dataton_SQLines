# Datos pesados: no versionar, usar scripts reproducibles en src/data/
data/raw/*
!data/raw/.gitkeep
data/external/*
!data/external/.gitkeep
# datos_bici/ (~1.9GB, con CSV mensuales de hasta 112MB) NO viene de un
# script reproducible (el equipo lo coloca directo en el repo, ver
# docs/fuentes_datos.md) - pero igual es demasiado pesado para git normal
# (GitHub rechaza cualquier archivo >100MB sin Git LFS). Se documenta aqui
# en vez de intentar subirlo: hay que compartirlo por otro medio (drive,
# almacenamiento en la nube) entre el equipo.
datos_bici/*
!datos_bici/.gitkeep

# Dump viejo de INEGI (~150 CSV, algunos de hasta 98MB, p.ej.
# atus_anual_*.csv) superado desde el 2026-09-15 por data/raw/ + los
# scripts de src/data/ (ver docs/fuentes_datos.md). Ya se retiro del
# tracking en este commit; se ignora la carpeta completa (incluye
# "talvez/", sin decidir todavia) para que nadie la vuelva a agregar por
# accidente con un `git add -A`.
data/csvs inegi/

# Python
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/

# R
.Rhistory

# Entorno
.env

# Streamlit
.streamlit/secrets.toml

# SO
.DS_Store
